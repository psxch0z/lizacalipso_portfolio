---
---

<section class="relative flex h-[100svh] min-h-[640px] w-full flex-col items-center justify-center overflow-hidden bg-ink grain">
  <div
    class="pointer-events-none absolute inset-0 opacity-80"
    style="background: radial-gradient(120% 90% at 50% 15%, rgba(255,47,143,0.20), transparent 60%), radial-gradient(90% 70% at 85% 90%, rgba(255,47,143,0.10), transparent 55%), linear-gradient(180deg, #060606 0%, #0c0c0c 55%, #060606 100%);"
  >
  </div>
  <div class="pointer-events-none absolute inset-0 animate-[pulse_10s_ease-in-out_infinite] opacity-40" style="background: radial-gradient(60% 40% at 25% 65%, rgba(255,47,143,0.16), transparent 70%);"></div>

  <div class="relative z-10 flex flex-col items-center px-6 text-center">
    <p class="mb-6 text-xs font-medium uppercase tracking-[0.45em] text-brand/90 opacity-0 animate-[fadeUp_1s_ease_forwards_0.1s]">
      Content creator · Reels production
    </p>
    <h1 class="font-display text-balance text-[clamp(2.75rem,11vw,7.5rem)] leading-[0.95] tracking-tight text-paper opacity-0 animate-[fadeUp_1.1s_ease_forwards_0.25s]">
      LIZA CALIPSO
    </h1>
    <p class="mt-6 max-w-xl text-balance font-script text-2xl text-paper/90 opacity-0 animate-[fadeUp_1s_ease_forwards_0.5s] sm:text-3xl">
      "I don't just capture moments. I tell stories."
    </p>
    <p class="mt-6 text-sm uppercase tracking-[0.3em] text-paper/50 opacity-0 animate-[fadeUp_1s_ease_forwards_0.7s]">
      Based in Omsk, Russia — available for brand collaborations &amp; creative projects
    </p>
  </div>

  <a
    href="#about"
    class="group absolute bottom-10 z-10 flex flex-col items-center gap-3 text-paper/50 opacity-0 animate-[fadeUp_1s_ease_forwards_1s] transition-colors hover:text-brand"
    aria-label="Scroll to About"
  >
    <span class="text-[10px] uppercase tracking-[0.35em]">Scroll</span>
    <span class="h-10 w-px bg-current opacity-60"></span>
  </a>
</section>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
