---
import { getCollection } from 'astro:content';
import CaseCard from './CaseCard.astro';

const allCases = await getCollection('cases');
const commercial = allCases
  .filter((c) => c.data.group === 'commercial')
  .sort((a, b) => a.data.order - b.data.order);

const filters = [
  { key: 'all', label: 'All' },
  { key: 'warm', label: 'Cinematic' },
  { key: 'bw', label: 'Documentary' },
  { key: 'promo', label: 'Promo' },
];
---

<section id="work" class="relative w-full bg-ink px-6 py-28 md:py-36">
  <div class="mx-auto max-w-6xl">
    <div class="mb-16 flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div data-reveal>
        <p class="mb-6 text-xs font-medium uppercase tracking-[0.4em] text-brand/80">Commercial projects</p>
        <img src="/images/tu-salsa-logo.webp" alt="TU SALSA — Dance Studio" class="mb-6 h-16 w-auto md:h-20" loading="lazy" />
        <h2 class="font-display text-[clamp(1.75rem,4vw,2.75rem)] text-paper text-balance">
          Постоянное сотрудничество с <span class="text-brand">TU SALSA</span>
        </h2>
        <p class="mt-4 max-w-lg text-paper/60">
          Студия латиноамериканских социальных танцев — атмосферные видео, контент с
          мероприятий, разговорные форматы, видео-приглашения, вовлекающие ролики.
        </p>
      </div>

      <div class="flex flex-wrap gap-2" data-filter-group>
        {filters.map((f) => (
          <button
            type="button"
            data-filter={f.key}
            class="rounded-full border border-paper/15 px-4 py-2 text-xs uppercase tracking-[0.2em] text-paper/60 transition-colors duration-300 hover:border-brand/50 hover:text-paper data-[active=true]:border-brand data-[active=true]:text-brand"
            data-active={f.key === 'all' ? 'true' : 'false'}
          >
            {f.label}
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="relative">
    <div
      class="scrollbar-hide -mx-6 flex snap-x snap-mandatory gap-5 overflow-x-auto px-6 pb-4 cursor-grab active:cursor-grabbing md:mx-auto md:max-w-6xl"
      data-case-grid
      data-reveal-group
    >
      {commercial.map((c, i) => (
        <div
          class="w-[78vw] shrink-0 snap-start sm:w-[46vw] md:w-[calc((100%-2.5rem)/2)] lg:w-[calc((100%-5rem)/3)]"
          data-case-item
          data-mood={c.data.mood}
        >
          <CaseCard
            title={c.data.title}
            project={c.data.project}
            format={c.data.format}
            task={c.data.task}
            role={c.data.role}
            mood={c.data.mood}
            index={i}
            slug={c.id}
            hasMedia={c.data.hasMedia}
          />
        </div>
      ))}
    </div>

    <div class="mx-auto mt-6 flex max-w-6xl justify-end gap-3 px-6">
      <button
        type="button"
        data-carousel-prev
        aria-label="Previous"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-paper/15 text-paper/60 transition-colors hover:border-brand hover:text-brand"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2 4 8l6 6"/></svg>
      </button>
      <button
        type="button"
        data-carousel-next
        aria-label="Next"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-paper/15 text-paper/60 transition-colors hover:border-brand hover:text-brand"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2l6 6-6 6"/></svg>
      </button>
    </div>
  </div>
</section>

<script>
  const group = document.querySelector('[data-filter-group]');
  const track = document.querySelector<HTMLElement>('[data-case-grid]');
  const items = document.querySelectorAll<HTMLElement>('[data-case-item]');

  group?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-filter]');
    if (!btn) return;
    const key = btn.dataset.filter;

    group.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('data-active', 'false'));
    btn.setAttribute('data-active', 'true');

    items.forEach((item) => {
      const show = key === 'all' || item.dataset.mood === key;
      item.style.display = show ? '' : 'none';
    });
    track?.scrollTo({ left: 0 });
  });

  const scrollByCard = (dir: number) => {
    if (!track) return;
    const card = track.querySelector<HTMLElement>('[data-case-item]:not([style*="display: none"])');
    const width = card ? card.getBoundingClientRect().width + 20 : 320;
    track.scrollBy({ left: dir * width });
  };

  document.querySelector('[data-carousel-prev]')?.addEventListener('click', () => scrollByCard(-1));
  document.querySelector('[data-carousel-next]')?.addEventListener('click', () => scrollByCard(1));

  // let a vertical mouse-wheel scroll the horizontal track
  track?.addEventListener(
    'wheel',
    (e) => {
      if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
      e.preventDefault();
      track.scrollLeft += e.deltaY;
    },
    { passive: false }
  );

  // click-and-drag with the mouse
  let isDragging = false;
  let dragMoved = false;
  let dragStartX = 0;
  let scrollStart = 0;

  track?.addEventListener('dragstart', (e) => e.preventDefault());

  track?.addEventListener('mousedown', (e) => {
    isDragging = true;
    dragMoved = false;
    dragStartX = e.pageX;
    scrollStart = track.scrollLeft;
  });

  window.addEventListener('mousemove', (e) => {
    if (!isDragging || !track) return;
    const dx = e.pageX - dragStartX;
    if (Math.abs(dx) > 6 && !dragMoved) {
      dragMoved = true;
      // CSS scroll-snap fights direct scrollLeft writes mid-gesture; drop it
      // while actively dragging and let it re-engage once the mouse is released.
      track.classList.remove('snap-x', 'snap-mandatory');
    }
    if (dragMoved) {
      e.preventDefault();
      track.scrollLeft = scrollStart - dx;
    }
  });

  window.addEventListener('mouseup', () => {
    isDragging = false;
    if (dragMoved) track?.classList.add('snap-x', 'snap-mandatory');
  });

  // dragging shouldn't also trigger a card's open-video click
  track?.addEventListener(
    'click',
    (e) => {
      if (dragMoved) {
        e.stopPropagation();
        e.preventDefault();
      }
      dragMoved = false;
    },
    { capture: true }
  );
</script>
