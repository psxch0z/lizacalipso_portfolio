---
const links = [
  { label: 'Instagram', href: 'https://instagram.com/lizacalipso', icon: 'instagram' as const },
  { label: 'Telegram', href: 'https://t.me/calipsoliza', icon: 'telegram' as const },
];
---

<section id="contact" class="relative w-full overflow-hidden bg-ink px-6 py-32 md:py-44 grain">
  <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(70% 60% at 50% 100%, rgba(255,47,143,0.14), transparent 60%);"></div>

  <div class="relative z-10 mx-auto flex max-w-4xl flex-col items-center text-center" data-reveal>
    <p class="mb-6 text-xs font-medium uppercase tracking-[0.4em] text-brand/80">Contact</p>
    <h2 class="font-display text-[clamp(2.2rem,6vw,4rem)] leading-[1.05] text-paper text-balance">
      Let's create something
    </h2>
    <p class="mt-2 font-script text-[clamp(2.6rem,7vw,5rem)] text-brand">beautiful</p>

    <div class="mt-14 flex flex-wrap items-center justify-center gap-4">
      {links.map((l) => (
        <a
          href={l.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative flex items-center gap-2.5 overflow-hidden rounded-full border border-paper/20 px-8 py-3 text-sm uppercase tracking-[0.2em] text-paper/80 transition-colors duration-300 hover:border-brand hover:text-ink"
        >
          <span class="absolute inset-0 -translate-x-full bg-brand transition-transform duration-300 ease-out group-hover:translate-x-0"></span>
          <svg class="relative h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {l.icon === 'instagram' ? (
              <>
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4.2" />
                <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
              </>
            ) : (
              <path d="M21 4.5 3 11.6l6.2 2.1M21 4.5 14.8 20l-5.6-6.3M21 4.5 9.2 13.7" />
            )}
          </svg>
          <span class="relative">{l.label}</span>
        </a>
      ))}
    </div>
  </div>

  <div class="relative z-10 mx-auto mt-28 flex max-w-6xl flex-col items-center justify-between gap-4 border-t border-paper/10 pt-8 text-xs text-paper/40 sm:flex-row">
    <span>© {new Date().getFullYear()} Liza Calipso</span>
    <span>Omsk, Russia</span>
  </div>
</section>
