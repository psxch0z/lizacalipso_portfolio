---
const links = [
  { label: 'Instagram', href: 'https://instagram.com/lizacalipso' },
  { label: 'Telegram', href: 'https://t.me/calipsoliza' },
];
---

<section id="contact" class="relative w-full overflow-hidden bg-ink px-6 py-32 md:py-44 grain">
  <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(70% 60% at 50% 100%, rgba(217,163,91,0.14), transparent 60%);"></div>

  <div class="relative z-10 mx-auto flex max-w-4xl flex-col items-center text-center" data-reveal>
    <p class="mb-6 text-xs font-medium uppercase tracking-[0.4em] text-warm/80">Contact</p>
    <h2 class="font-display text-[clamp(2.4rem,6vw,4.5rem)] font-medium leading-[1.05] text-paper text-balance">
      Let's create something<br /><span class="italic text-warm">beautiful</span>
    </h2>

    <div class="mt-14 flex flex-wrap items-center justify-center gap-4">
      {links.map((l) => (
        <a
          href={l.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative overflow-hidden rounded-full border border-paper/20 px-8 py-3 text-sm uppercase tracking-[0.2em] text-paper/80 transition-colors duration-300 hover:border-warm hover:text-ink"
        >
          <span class="absolute inset-0 -translate-x-full bg-warm transition-transform duration-300 ease-out group-hover:translate-x-0"></span>
          <span class="relative">{l.label}</span>
        </a>
      ))}
    </div>
  </div>

  <div class="relative z-10 mx-auto mt-28 flex max-w-6xl flex-col items-center justify-between gap-4 border-t border-paper/10 pt-8 text-xs text-paper/40 sm:flex-row">
    <span>© {new Date().getFullYear()} Liza Calipso</span>
    <span>Omsk, Russia</span>
  </div>
</section>
