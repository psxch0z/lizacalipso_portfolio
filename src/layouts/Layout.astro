---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'LIZA CALIPSO — Content creator • Reels production',
  description = 'Контент-крейтор и reels-мейкер из Омска. Съёмка и монтаж вертикальных видео для брендов, мероприятий и личных проектов.',
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Marck+Script&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="antialiased selection:bg-[var(--color-brand)]">
    <slot />

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
      );

      document.querySelectorAll('[data-reveal]').forEach((el, i) => {
        const group = el.closest('[data-reveal-group]');
        if (group) {
          el.style.setProperty('--reveal-index', String(i % 8));
        }
        io.observe(el);
      });

      // hover preview: play/pause the muted preview loop on card hover
      document.querySelectorAll<HTMLElement>('[data-hover-video]').forEach((card) => {
        const video = card.querySelector<HTMLVideoElement>('[data-preview-video]');
        if (!video) return;
        const src = card.dataset.hoverVideo;

        const play = () => {
          if (card.dataset.playing === 'true') return;
          if (!video.src && src) video.src = src;
          video.currentTime = 0;
          video.classList.add('opacity-100');
          video.play().catch(() => {});
        };
        const stop = () => {
          video.pause();
          video.classList.remove('opacity-100');
        };

        card.addEventListener('mouseenter', play);
        card.addEventListener('mouseleave', stop);
        card.addEventListener('focus', play);
        card.addEventListener('blur', stop);
      });

      // inline playback: clicking a card expands its own full-quality video in place
      let activeCard: HTMLElement | null = null;

      const deactivate = (card: HTMLElement) => {
        const full = card.querySelector<HTMLVideoElement>('[data-full-video-el]');
        if (full) {
          full.pause();
          full.currentTime = 0;
        }
        delete card.dataset.playing;
      };

      const activate = (card: HTMLElement) => {
        if (activeCard && activeCard !== card) deactivate(activeCard);
        const full = card.querySelector<HTMLVideoElement>('[data-full-video-el]');
        if (!full) return;
        const src = card.dataset.fullVideo;
        if (!full.src && src) full.src = src;
        card.dataset.playing = 'true';
        card.querySelector<HTMLElement>('[data-loading-spinner]')?.classList.add('opacity-100');
        full.play().catch(() => {});
        activeCard = card;
      };

      document.querySelectorAll<HTMLElement>('[data-full-video]').forEach((card) => {
        const full = card.querySelector<HTMLVideoElement>('[data-full-video-el]');
        const pauseIcon = card.querySelector<HTMLElement>('[data-pause-icon]');
        const spinner = card.querySelector<HTMLElement>('[data-loading-spinner]');

        full?.addEventListener('waiting', () => {
          spinner?.classList.add('opacity-100');
          pauseIcon?.classList.remove('opacity-100');
        });
        full?.addEventListener('playing', () => {
          spinner?.classList.remove('opacity-100');
          pauseIcon?.classList.remove('opacity-100');
        });
        full?.addEventListener('pause', () => {
          spinner?.classList.remove('opacity-100');
          pauseIcon?.classList.add('opacity-100');
        });

        card.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          if (target.closest('[data-card-close]')) {
            deactivate(card);
            if (activeCard === card) activeCard = null;
            return;
          }
          if (card.dataset.playing === 'true') {
            if (full) full.paused ? full.play().catch(() => {}) : full.pause();
            return;
          }
          activate(card);
        });
        card.addEventListener('keydown', (e) => {
          if (e.key !== 'Enter') return;
          if (card.dataset.playing !== 'true') {
            activate(card);
          } else if (full) {
            full.paused ? full.play().catch(() => {}) : full.pause();
          }
        });
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && activeCard) {
          deactivate(activeCard);
          activeCard = null;
        }
      });
    </script>
  </body>
</html>
