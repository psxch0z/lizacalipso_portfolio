---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import BigQuote from '../components/BigQuote.astro';
import Services from '../components/Services.astro';
import Portfolio from '../components/Portfolio.astro';
import PersonalProjects from '../components/PersonalProjects.astro';
import Contacts from '../components/Contacts.astro';
---

<Layout>
  <Nav />
  <main>
    <Hero />
    <About />
    <BigQuote eyebrow="Кто я">
      Люди запоминают не просто кадры — а те видео, которые заставили их что-то почувствовать.
    </BigQuote>
    <Services />
    <Portfolio />
    <PersonalProjects />
    <Contacts />
  </main>
</Layout>
